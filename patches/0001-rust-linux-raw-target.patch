+use crate::spec::{Cc, LinkerFlavor, Lld, RelocModel, SanitizerSet, Target, TargetMetadata};
+
+pub(crate) fn target() -> Target {
+    let mut target = super::x86_64_unknown_linux_gnu::target();
+    let options = &mut target.options;
+    options.dynamic_linking = false;
+    options.has_rpath = false;
+    options.position_independent_executables = false;
+    options.static_position_independent_executables = false;
+    options.relocation_model = RelocModel::Static;
+    options.crt_static_default = true;
+    options.supported_sanitizers = SanitizerSet::empty();
+    options.supports_fentry = false;
+    options.supports_xray = false;
+    options.add_pre_link_args(
+        LinkerFlavor::Gnu(Cc::Yes, Lld::No),
+        &["-nostdlib", "-static", "-no-pie", "-Wl,-u,_start"],
+    );
+    target.metadata = TargetMetadata {
+        description: Some("Experimental static Linux with c-scape and Origin".into()),
+        tier: Some(3),
+        host_tools: Some(false),
+        std: Some(true),
+    };
+    target
+}
